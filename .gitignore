config/xt-assets.mk

# Release signing keys. NEVER commit these: whoever holds them can sign an OTA the
# device accepts as genuine. Generated by build/gen-release-keys.sh, which used to
# claim this file already covered them — it did not, so the claim was false and the
# keys would have been committable on the first `git add -A`.
keys/
*.pk8
*.x509.pem
verity_key.pem
