// SPDX-License-Identifier: Apache-2.0
//
// XtStatus — the "is my phone actually healthy" app.
//
// This is the user-visible end of the memory/efficiency work: it reads real
// /proc values and shows MemAvailable, zram compression, and lmkd pressure, so
// claims about idle behaviour can be checked on the device instead of trusted.
//
// It deliberately does NOT ship a service, a widget, or a background job. It
// reads values when opened and stops existing when closed — an app about
// efficiency that itself burns battery would be self-refuting.

android_app {
    name: "XtStatus",
    manifest: "AndroidManifest.xml",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    platform_apis: true,
    certificate: "platform",
    product_specific: true,
    aaptflags: ["--no-version-vectors"],
}
