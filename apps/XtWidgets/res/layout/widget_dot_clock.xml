<?xml version="1.0" encoding="utf-8"?>
<!--
    True black (#FF000000) background: on the M31's Super AMOLED panel those pixels
    are physically off, which is both the Nothing aesthetic and a real power saving
    for a widget that is on screen whenever the home screen is.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dot_clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="#FF000000"
    android:padding="8dp">

    <ImageView
        android:id="@+id/dot_clock_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitCenter"
        android:tint="#FFFFFFFF"
        android:contentDescription="@string/widget_clock_desc" />

    <TextView
        android:id="@+id/dot_clock_suffix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingStart="4dp"
        android:paddingBottom="6dp"
        android:textColor="#FF9A9A9A"
        android:textSize="10sp" />
</LinearLayout>
