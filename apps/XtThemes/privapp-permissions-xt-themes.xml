<?xml version="1.0" encoding="utf-8"?>
<!--
    CHANGE_OVERLAY_PACKAGES is a signature|privileged permission. It is granted
    explicitly here rather than relying on the platform signature alone, so the
    grant survives a signing change and the intent is documented in-tree.
-->
<permissions>
    <privapp-permissions package="os.xt.themes">
        <permission name="android.permission.CHANGE_OVERLAY_PACKAGES" />
    </privapp-permissions>
</permissions>
