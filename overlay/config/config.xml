<?xml version="1.0" encoding="utf-8"?>
<!--
    Default overlay enablement.

    Stock Infinity-X / AOSP design is the shipping default (all custom RRO
    palettes start disabled). The user can opt into Nothing Dark, Nothing Light,
    or Monet at runtime via XtThemes.
-->
<config>
    <overlay package="os.theme.nothing" enabled="false" />
    <overlay package="os.theme.nothinglight" enabled="false" />
    <overlay package="os.theme.monet" enabled="false" />
    <overlay package="os.theme.stock" enabled="false" />
</config>
