<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing Light — white surfaces, black glyphs, one red accent.

    Only public framework resources are overridden here (system_neutral1_*,
    system_accent1_*); the non-public device_default entries are set as well
    because AndroidBlackTheme demonstrates the framework resolves them, but the
    theme does not depend on that.
-->
<resources>
    <color name="system_neutral1_50">#FFFFFF</color>
    <color name="system_neutral1_100">#F7F7F7</color>
    <color name="system_neutral1_900">#000000</color>
    <color name="system_neutral2_50">#FFFFFF</color>
    <color name="system_accent1_100">#D71921</color>
    <color name="system_accent1_500">#D71921</color>
    <color name="system_accent1_600">#D71921</color>
    <color name="background_device_default_light">#FFFFFF</color>
    <color name="primary_device_default_light">#FFFFFF</color>
</resources>
