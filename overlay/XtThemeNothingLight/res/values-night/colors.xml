<?xml version="1.0" encoding="utf-8"?>
<!--
    Light theme at night still needs dark surfaces: the system flips to
    values-night whenever the user's dark-mode schedule says so, and a light
    palette there would produce white flashbang screens at 3am.
-->
<resources>
    <color name="system_neutral1_900">#000000</color>
    <color name="system_accent1_500">#D71921</color>
    <color name="background_device_default_dark">#000000</color>
</resources>
