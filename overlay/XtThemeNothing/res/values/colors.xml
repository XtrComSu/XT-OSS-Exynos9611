<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing-style palette. True black (#000000) is the default background: on the
    M31's Super AMOLED panel those pixels are physically off, which is both the
    intended aesthetic and a measurable display-power saving.

    Accent red #D71921 is the single accent for the entire system.
-->
<resources>
    <color name="nothing_black">#FF000000</color>
    <color name="nothing_surface">#FF0A0A0A</color>
    <color name="nothing_line">#FF1F1F1F</color>
    <color name="nothing_white">#FFFFFFFF</color>
    <color name="nothing_grey">#FF9A9A9A</color>
    <color name="nothing_dim">#FF5C5C5C</color>
    <color name="nothing_red">#FFD71921</color>
</resources>
