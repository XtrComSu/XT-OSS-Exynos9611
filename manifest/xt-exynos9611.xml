<?xml version="1.0" encoding="UTF-8"?>
<!--
    XT-OSS-Exynos9611 — overlay manifest for Project Infinity X 4.2 (Android 17)

    Purpose: the upstream M31-family trees carry `lineage.dependencies` files that
    resolve against the manifest's DEFAULT remote (github.com/ProjectInfinity-X),
    where none of those repos exist. Every dependency is re-pinned here instead.

    Usage:
        repo init -u https://github.com/ProjectInfinity-X/manifest -b 17 ...
        cp XT-OSS-Exynos9611/manifest/xt-exynos9611.xml <tree>/.repo/local_manifests/
        repo sync -c (force-sync and prune recommended)

    Or just run: ./bootstrap/00-bootstrap.sh ~/xt

    Branch policy (verified 2026-11-17 via GitHub API):
        device/vendor trees  Parbindar7/*  branch lineage-24.0   (Android 17)
        kernel               XtrComSu/*    branch ksun-susfs  (KSUN + SUSFS)
        hardware/epolicy     LineageOS/*   branch lineage-24.0
-->
<manifest>

  <!-- ==================== remotes ==================== -->
  <remote name="parbindar" fetch="https://github.com/Parbindar7" revision="lineage-24.0" />
  <!--
       NOTE: the xtk remote deliberately declares NO default revision.
       Its two projects need different branches (kernel = lineage-24.0-KSUN,
       overlay = main). A default here would silently send any future
       project without an explicit revision to the kernel branch, which is a
       confusing failure. Omitting it makes that omission obvious.
  -->
  <remote name="xtk"       fetch="https://github.com/XtrComSu" />
  <remote name="los"       fetch="https://github.com/LineageOS"  revision="lineage-24.0" />

  <!-- ==================== shared: Exynos 9611 common fabric ==================== -->
  <project path="device/samsung/universal9611-common"
           name="android_device_samsung_universal9611-common" remote="parbindar" />
  <project path="vendor/samsung/universal9611-common"
           name="android_vendor_samsung_universal9611-common" remote="parbindar" />

  <!-- ==================== device: Galaxy M31 (SM-M315F) — PRIMARY ==================== -->
  <project path="device/samsung/m31" name="android_device_samsung_m31" remote="parbindar" />
  <project path="vendor/samsung/m31" name="android_vendor_samsung_m31" remote="parbindar" />

  <!-- ==================== device: Galaxy M31s (SM-M317F) ==================== -->
  <project path="device/samsung/m31s" name="android_device_samsung_m31s" remote="parbindar" />
  <project path="vendor/samsung/m31s" name="android_vendor_samsung_m31s" remote="parbindar" />

  <!-- ==================== device: Galaxy F41 (SM-F415F) ==================== -->
  <project path="device/samsung/f41" name="android_device_samsung_f41" remote="parbindar" />
  <project path="vendor/samsung/f41" name="android_vendor_samsung_f41" remote="parbindar" />

  <!-- ==================== device: Galaxy M21 (SM-M215F) ==================== -->
  <project path="device/samsung/m21" name="android_device_samsung_m21" remote="parbindar" />
  <project path="vendor/samsung/m21" name="android_vendor_samsung_m21" remote="parbindar" />

  <!-- ==================== device: Galaxy A51 (SM-A515F) ==================== -->
  <!-- NOTE: a51 has TARGET_HAS_FOD := true and NXP NFC; it is the odd one out. -->
  <project path="device/samsung/a51" name="android_device_samsung_a51" remote="parbindar" />
  <project path="vendor/samsung/a51" name="android_vendor_samsung_a51" remote="parbindar" />

  <!-- ==================== OUR kernel (KSUN + SUSFS) ==================== -->
  <!-- ==================== kernel (ours, not upstream's) ====================
       revision="ksun-susfs", NOT lineage-24.0-KSUN.

       lineage-24.0-KSUN has KernelSU-Next but NO SUSFS at all: no fs/susfs.c, no
       include/linux/susfs.h, no CONFIG_KSU_SUSFS. Since the ROM's stated goal is
       KSUN + SUSFS native, that branch cannot satisfy it.

       ksun-susfs (73420a8) carries the real thing — fs/susfs.c is 58229 bytes, and
       exynos9611-m31_defconfig already contains:
           CONFIG_KSU=y
           CONFIG_KSU_MANUAL_HOOK=y
           CONFIG_KSU_SUSFS=y
           CONFIG_KSU_SUSFS_SUS_PATH / SUS_MOUNT / SUS_KSTAT / TRY_UMOUNT = y

       The two branches have diverged (ksun-susfs is 142 ahead, 7 behind). The 7
       commits it lacks are all build tooling — AnyKernel3, build_kernel script,
       DTB/DTBO build support, and the KernelSU-Next submodule integration — none of
       which this ROM uses, because AOSP builds the kernel from
       TARGET_KERNEL_CONFIG rather than the repo's own script.

       That last point matters practically: ksun-susfs integrates KernelSU as a real
       directory, whereas lineage-24.0-KSUN reaches it through a git SUBMODULE
       (drivers/kernelsu -> ../KernelSU-Next/kernel) that `repo sync` does NOT
       populate. On that branch the tree arrives with drivers/kernelsu/Kconfig
       missing while drivers/Kconfig still sources it, so the kernel cannot even be
       configured until someone remembers to initialise the submodule by hand.
       ksun-susfs has no such trap.
  -->
  <project path="kernel/samsung/universal9611"
           name="android_kernel_samsung_universal9611"
           remote="xtk"
           revision="ksun-susfs" />

  <!-- ==================== hardware / HALs / sepolicy ==================== -->
  <project path="device/samsung_slsi/sepolicy"           name="android_device_samsung_slsi_sepolicy"            remote="los" />
  <project path="hardware/samsung"                       name="android_hardware_samsung"                        remote="los" />
  <project path="hardware/samsung_slsi/libbt"            name="android_hardware_samsung_slsi_libbt"             remote="los" />
  <project path="hardware/samsung_slsi-linaro/config"    name="android_hardware_samsung_slsi-linaro_config"     remote="los" />
  <project path="hardware/samsung_slsi-linaro/exynos"    name="android_hardware_samsung_slsi-linaro_exynos"     remote="los" />
  <project path="hardware/samsung_slsi-linaro/exynos5"   name="android_hardware_samsung_slsi-linaro_exynos5"    remote="los" />
  <project path="hardware/samsung_slsi-linaro/graphics"  name="android_hardware_samsung_slsi-linaro_graphics"   remote="los" />
  <project path="hardware/samsung_slsi-linaro/interfaces" name="android_hardware_samsung_slsi-linaro_interfaces" remote="los" />
  <project path="hardware/samsung_slsi-linaro/openmax"   name="android_hardware_samsung_slsi-linaro_openmax"    remote="los" />
  <project path="hardware/samsung_slsi/scsc_wifibt/wifi_hal"
           name="android_hardware_samsung_slsi_scsc_wifibt_wifi_hal" remote="los" />
  <project path="hardware/samsung_slsi/scsc_wifibt/wpa_supplicant_lib"
           name="android_hardware_samsung_slsi_scsc_wifibt_wpa_supplicant_lib" remote="los" />

  <!-- ==================== our overlay layer ==================== -->
  <project path="vendor/xt" name="XT-OSS-Exynos9611" remote="xtk" revision="main" />

</manifest>
